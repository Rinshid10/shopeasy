# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Flipkart Affiliate API credentials (not used yet).
# Server-only: never prefix these with NEXT_PUBLIC_ and only read them inside lib/.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
