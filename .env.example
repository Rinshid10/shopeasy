# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Supabase project (Project Settings → API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Apify, for importing a product from its Meesho link in the admin (server only, keep secret).
# Get it at apify.com → Settings → Integrations.
APIFY_TOKEN=
# Optional: a different Apify scraper. Default: jobscrawler~meesho-product-detail-scraper
APIFY_MEESHO_ACTOR=
